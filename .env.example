# ============================================================
# Free System Villegas - Client - Environment Variables
# ============================================================
# Copy this file to .env and configure the values.
# All variables must start with VITE_ to be available in the
# client (Vite exposes variables with the VITE_ prefix).
# ============================================================

# Backend API base URL
# Must point to the Free System Villegas backend server
# Allowed values: full URL including protocol and port
# Local example: http://localhost:3000
# Production example: https://api.freesystemvillegas.com
VITE_API_URL=http://localhost:3000
